{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://neuroai-brain-detection.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://neuroai-brain-detection.onrender.com/uploads/:path*"
    },
    {
      "source": "/sample_images/:path*",
      "destination": "https://neuroai-brain-detection.onrender.com/sample_images/:path*"
    }
  ]
}
